[Unit]
Description=CapsWriter Plus HTTP transcription API
Documentation=https://github.com/Vanilla-Yukirin/CapsWriter-Offline/blob/backup/yukirin-server-linux/docs/CapsWriter-Plus-HTTP-API.md
After=network-online.target capswriter-server.service
Wants=network-online.target

StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple

WorkingDirectory=/data/CapsWriter-Offline
EnvironmentFile=%h/.config/capswriter/capswriter.env
EnvironmentFile=%h/.config/capswriter/api.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/data/CapsWriter-Offline/.venv/bin/python-host /data/CapsWriter-Offline/core_api.py

Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=15s
UMask=0077

PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=default.target
