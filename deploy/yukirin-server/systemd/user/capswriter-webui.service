[Unit]
Description=CapsWriter Online local read-only Web UI
Documentation=https://github.com/Vanilla-Yukirin/CapsWriter-Offline
After=network-online.target capswriter-server.service
Wants=network-online.target

StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple

WorkingDirectory=/data/CapsWriter-Offline
EnvironmentFile=%h/.config/capswriter/capswriter.env
EnvironmentFile=-%h/.config/capswriter/webui.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=CAPSWRITER_WEBUI_HOST=127.0.0.1
Environment=CAPSWRITER_WEBUI_PORT=6017
Environment=CAPSWRITER_WEBUI_SECURE_COOKIE=0
ExecStart=/data/CapsWriter-Offline/.venv/bin/python-host /data/CapsWriter-Offline/core_webui.py

Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=10s
UMask=0077

PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=default.target
