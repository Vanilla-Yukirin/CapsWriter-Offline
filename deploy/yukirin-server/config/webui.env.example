# Optional Web UI runtime metadata.
# Copy to ~/.config/capswriter/webui.env with mode 0600.
# The required CAPSWRITER_TOKEN remains in capswriter.env.
CAPSWRITER_LOG_PATH=/data/CapsWriter-Offline/logs/server_latest.log
CAPSWRITER_INSTANCE_NAME=CapsWriter Plus
CAPSWRITER_ASR_PORT=6016
CAPSWRITER_ASR_STATUS_URL=http://127.0.0.1:6016/status
CAPSWRITER_API_ENABLED=1
CAPSWRITER_API_PORT=6018
CAPSWRITER_API_STATUS_URL=http://127.0.0.1:6018/readyz
CAPSWRITER_BUILD_ID=development
CAPSWRITER_WEBUI_SESSION_TTL=43200
