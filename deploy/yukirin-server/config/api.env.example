# Copy to ~/.config/capswriter/api.env with mode 0600.
# The one required CAPSWRITER_TOKEN stays in capswriter.env.
CAPSWRITER_API_HOST=0.0.0.0
CAPSWRITER_API_PORT=6018
CAPSWRITER_API_ASR_URL=ws://127.0.0.1:6016/asr
CAPSWRITER_API_ASR_STATUS_URL=http://127.0.0.1:6016/status
CAPSWRITER_API_MAX_UPLOAD_BYTES=268435456
CAPSWRITER_API_MAX_DURATION_SECONDS=7200
CAPSWRITER_API_MAX_CONCURRENCY=1
CAPSWRITER_API_QUEUE_TIMEOUT_SECONDS=5
CAPSWRITER_API_REQUEST_TIMEOUT_SECONDS=3600
